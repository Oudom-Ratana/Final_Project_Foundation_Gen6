{
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "https://cinema-booking-api.eunglyzhia.com/uploads/:path*"
    },
    {
      "source": "/(movies?|stream)/:id*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebookexternalhit|twitterbot|telegrambot|slackbot|discordbot|whatsapp|linkedinbot).*"
        }
      ],
      "destination": "/api/og?path=$1/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
